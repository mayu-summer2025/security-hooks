#!/bin/bash

# Git pre-commit hook to run Gitleaks on staged files
# Place this file in .git/hooks/pre-commit and make it executable

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running Gitleaks pre-commit hook...${NC}"

# Get staged files only
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  echo -e "${YELLOW}No staged files to check.${NC}"
  exit 0
fi

# Create a temporary directory
TEMP_DIR=$(mktemp -d)
trap 'rm -rf "$TEMP_DIR"' EXIT

# Copy staged files to temp directory
for FILE in $STAGED_FILES; do
  DIRNAME=$(dirname "$FILE")
  mkdir -p "$TEMP_DIR/$DIRNAME"
  git show ":$FILE" > "$TEMP_DIR/$FILE"
done

# Copy gitleaks config to temp dir if it exists
if [ -f ".gitleaks.toml" ]; then
  cp .gitleaks.toml "$TEMP_DIR/"
else
  # Create minimal config for the scan
  cat > "$TEMP_DIR/.gitleaks.toml" << 'EOL'
# Minimal Gitleaks Configuration for pre-commit hook
title = "Gitleaks Config"

# GitHub Secrets
[[rules]]
id = "github-pat"
description = "GitHub Personal Access Token"
regex = '''(?i)(?:github|gh)(?:[_-])?(?:pat|token|key|secret)(?:[_-])?=?(?:[\s\n\r]*['"`])([0-9a-zA-Z_]{35,255})(?:['"`])'''
secretGroup = 1
keywords = ["github", "token", "pat", "ghp_"]

# Google Cloud/GCP Secrets
[[rules]]
id = "google-api-key"
description = "Google API Key"
regex = '''(?i)(?:google|gcp|youtube|drive|yt)(?:[_-])?(?:api|apikey|api[_-]?key|key|api[_-]?key[_-]?id)(?:[_-])?=?(?:[\s\n\r]*['"`])?([a-zA-Z0-9_-]{32,45})(?:['"`])?'''
secretGroup = 1
keywords = ["google", "gcp", "api", "key", "AIza"]

# Jenkins Secrets
[[rules]]
id = "jenkins-api-token"
description = "Jenkins API Token"
regex = '''(?i)(?:jenkins)(?:[_-])?(?:api|token|key|secret)(?:[_-])?=?(?:[\s\n\r]*['"`])?([0-9a-zA-Z]{30,64})(?:['"`])?'''
secretGroup = 1
keywords = ["jenkins", "api", "token"]

# AWS (commonly used with GCP and Jenkins)
[[rules]]
id = "aws-access-key"
description = "AWS Access Key ID"
regex = '''(?i)(?:aws|amazon)(?:[_-])?(?:access|account|key|secret)(?:[_-])?(?:id|key|token)(?:[_-])?=?(?:[\s\n\r]*['"`])?([A-Z0-9]{20})(?:['"`])?'''
secretGroup = 1
keywords = ["aws", "amazon", "access", "key", "AKIA"]
EOL
fi

# Check if Docker is available
if command -v docker &> /dev/null; then
  # Run gitleaks with Docker
  echo -e "${YELLOW}Running Gitleaks scan with Docker...${NC}"
  
  docker run --rm -v "$TEMP_DIR:/scan" \
    -e GITLEAKS_REPORT_ALL=true \
    zricethezav/gitleaks:latest \
    detect \
    --source="/scan" \
    --config="/scan/.gitleaks.toml" \
    --verbose \
    --no-git
  
  GITLEAKS_EXIT=$?
else
  # Check if native gitleaks is available
  if command -v gitleaks &> /dev/null; then
    echo -e "${YELLOW}Running Gitleaks scan with native binary...${NC}"
    
    # Run gitleaks with native binary
    cd "$TEMP_DIR" && gitleaks detect \
      --source="." \
      --config=".gitleaks.toml" \
      --verbose \
      --no-git \
      --report-format=json \
      --report-path=report.json
    
    GITLEAKS_EXIT=$?
  else
    echo -e "${RED}ERROR: Neither Docker nor Gitleaks binary found.${NC}"
    echo -e "${YELLOW}Please install Docker or Gitleaks to use this pre-commit hook.${NC}"
    echo -e "${YELLOW}Skipping Gitleaks scan...${NC}"
    exit 0
  fi
fi

# Check gitleaks exit code
if [ $GITLEAKS_EXIT -eq 0 ]; then
  echo -e "${GREEN}No secrets found in staged files.${NC}"
  exit 0
else
  echo -e "${RED}ERROR: Gitleaks found potential secrets in your staged files!${NC}"
  echo -e "${RED}Commit aborted. Please remove the secrets and try again.${NC}"
  echo -e "${YELLOW}To bypass this check (NOT RECOMMENDED), use:${NC}"
  echo -e "${YELLOW}  git commit --no-verify${NC}"
  exit 1
fi